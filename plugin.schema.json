{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AWS Quick Official Catalog Plugin",
  "description": "Schema for plugins/<category>/<name>/plugin.json.",
  "type": "object",
  "required": [
    "id",
    "name",
    "displayName",
    "description",
    "version",
    "author",
    "skills"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Stable plugin ID: a lowercase hyphenated UUIDv4 (8-4-4-4-12). Assigned once by scripts/asset_ids.py and never changed, even when the plugin moves or is renamed."
    },
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "description": "Kebab-case plugin identifier. Must match the plugin directory name."
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Name shown in AWS Quick. A displayName on the plugin's catalog.json entry overrides it."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "What the plugin does and who it is for."
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version (MAJOR.MINOR.PATCH)."
    },
    "author": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Publisher name. Amazon, AWS, Amazon Web Services, or AWS Quick marks a first-party plugin; any other name marks a third-party plugin."
        }
      }
    },
    "icon": {
      "type": "string",
      "pattern": "^assets/[a-z0-9][a-z0-9._-]*\\.svg$",
      "description": "Plugin-relative path to an SVG icon of at most 5 KB. Required for first-party plugins. An icon on the plugin's catalog.json entry overrides it."
    },
    "kind": {
      "type": "string",
      "enum": [
        "solution",
        "package",
        "partner"
      ],
      "description": "Plugin kind. A kind on the plugin's catalog.json entry overrides it."
    },
    "categories": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "description": "Other catalog categories to list the plugin under. Each must be a category in catalog.json."
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]/[a-z0-9]([a-z0-9_-]*[a-z0-9])?$"
      },
      "description": "Skills the plugin installs, as <category>/<name> references to skills/<category>/<name>. Each skill must be published in the catalog."
    },
    "connectors": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/ConnectorSlot"
      },
      "description": "The connector the plugin needs. At most one."
    }
  },
  "$defs": {
    "ConnectorType": {
      "type": "string",
      "enum": [
        "SERVICENOW_NOW_PLATFORM",
        "SALESFORCE_CRM",
        "MICROSOFT_OUTLOOK",
        "GOOGLE_DRIVE",
        "PAGERDUTY_ADVANCE",
        "JIRA_CLOUD",
        "ATLASSIAN_CONFLUENCE",
        "AMAZON_S3",
        "AMAZON_BEDROCK_AGENT_RUNTIME",
        "AMAZON_BEDROCK_RUNTIME",
        "AMAZON_BEDROCK_DATA_AUTOMATION_RUNTIME",
        "AMAZON_TEXTRACT",
        "AMAZON_COMPREHEND",
        "AMAZON_COMPREHEND_MEDICAL",
        "MICROSOFT_ONEDRIVE",
        "MICROSOFT_SHAREPOINT",
        "MICROSOFT_TEAMS",
        "SAP_BUSINESSPARTNER",
        "SAP_PRODUCTMASTERDATA",
        "SAP_PHYSICALINVENTORY",
        "SAP_BILLOFMATERIALS",
        "SAP_MATERIALSTOCK",
        "ZENDESK_SUITE",
        "SMARTSHEET",
        "SLACK",
        "ASANA",
        "BAMBOO_HR",
        "FACTSET",
        "BOX_AGENT",
        "S_AND_P_GLOBAL_ENERGY",
        "PAGER_DUTY_AGENT",
        "S_AND_P_GLOBAL_MARKET_INTELLIGENCE",
        "CANVA_AGENT",
        "VISIER_AGENT",
        "REVINOVA_AGENT",
        "GITHUB",
        "NOTION",
        "LINEAR",
        "HUGGINGFACE",
        "MONDAY",
        "HUBSPOT",
        "INTERCOM",
        "STRIPE",
        "NEW_RELIC",
        "SNOWFLAKE",
        "ZAPIER",
        "MOODYS",
        "DROPBOX",
        "GOOGLE_MEET",
        "GOOGLE_SHEETS",
        "GOOGLE_DOCS",
        "GOOGLE_SLIDES",
        "GOOGLE_ANALYTICS",
        "GOOGLE_CALENDAR",
        "GMAIL",
        "ZOOM",
        "QUICKBOOKS",
        "AIRTABLE",
        "MICROSOFT_ONENOTE",
        "WORKDAY",
        "GOOGLE_CHAT",
        "SHOPIFY",
        "FIGMA",
        "WHATSAPP",
        "CALENDLY",
        "GITLAB",
        "BITBUCKET",
        "TWILIO",
        "ADOBE",
        "CISCO_WEBEX_VIDCAST",
        "CISCO_WEBEX_MEETINGS",
        "DUN_AND_BRADSTREET",
        "AMPLITUDE",
        "HG_INSIGHTS",
        "ZOOM_INFO",
        "BOX",
        "CANVA",
        "VISIER",
        "CISCO_WORKSPACES",
        "BEE",
        "AMAZON_SELLING_PARTNER",
        "GONG",
        "META_ADS",
        "VERISK",
        "DOCUSIGN",
        "EPIQ_AI",
        "INFORMATICA_CATALOG_DISCOVERY",
        "INFORMATICA_DATA_EXPLORER",
        "LUMINANCE",
        "NET_DOCUMENTS",
        "MOODYS_GROWTH_STRATEGY",
        "HARVEY_LEGAL_AI",
        "CORNERSTONE_ON_DEMAND",
        "PLAID",
        "TURBOTAX",
        "XERO",
        "ZOHO_EMAIL",
        "ZOHO_CRM",
        "AWS_EVENTS_CENTRAL",
        "FABRIC_IQ",
        "TABLEAU",
        "CLIO",
        "LEGORA"
      ],
      "description": "A built-in AWS Quick connector type. The values mirror the ActionConnectorType enum in the AWS Quick service model (code.amazon.com/packages/SpaceNeedleActionServiceModel/blobs/mainline/--/src/main/smithy/common/enums.smithy), which lists more types than the public CreateActionConnector API reference. This file is published with the catalog, so it lists only types a plugin can use and that are fine to publish. These are left out: open-ended types (GENERIC_HTTP, OPEN_API, MODEL_CONTEXT_PROTOCOL, A2A_AGENT), because AWS Quick matches a slot to a customer's connectors by type and every connector of such a type would match; test types (TEST_MCP_CONNECTOR, TEST_MCP_CONNECTOR_MCP_SYNC); and types AWS Quick sets up on its own, such as default search and web search (EXTERNAL_SEARCH, NEXO_EXTERNAL_SEARCH, QUICK_DOCS_SEARCH) and Amazon's internal variants (INTERNAL_*). If a connector you need is missing, look it up in that file and add its exact value here."
    },
    "ConnectorSlot": {
      "type": "object",
      "required": [
        "key",
        "label",
        "types",
        "required"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "description": "Identifier for the slot."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Name of the slot shown at install."
        },
        "description": {
          "type": "string",
          "maxLength": 1024,
          "description": "What the connector is used for."
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ConnectorType"
          },
          "description": "Connector types that can fill the slot, for example SALESFORCE_CRM."
        },
        "required": {
          "const": true,
          "description": "Must be true."
        }
      }
    }
  }
}
