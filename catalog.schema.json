{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AWS Quick Official Catalog",
  "description": "Schema for the AWS Quick Official Catalog used to list skills and assets.",
  "type": "object",
  "required": [
    "skillsChecksum",
    "categories",
    "roles",
    "industries"
  ],
  "additionalProperties": false,
  "properties": {
    "skillsChecksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Roll-up SHA-256 over the per-skill checksums of the published set (sorted 'path\\tchecksum' lines), generated by scripts/skills_checksum.py."
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "description": "The category filter that current AWS Quick versions show. Every released skill and plugin has an entry here. Keep it until every AWS Quick version reads roles and industries.",
      "items": {
        "$ref": "#/$defs/Category"
      }
    },
    "roles": {
      "type": "array",
      "description": "Role filter values for AWS Quick versions that read roles and industries. Each lists, by path, assets that categories already lists. Every catalog asset is in exactly one role or one industry, never both; scripts/catalog_check.py enforces this.",
      "items": {
        "$ref": "#/$defs/AssetGroup"
      }
    },
    "industries": {
      "type": "array",
      "description": "Industry filter values for AWS Quick versions that read roles and industries. Each lists, by path, assets that categories already lists. Every catalog asset is in exactly one role or one industry, never both; scripts/catalog_check.py enforces this.",
      "items": {
        "$ref": "#/$defs/AssetGroup"
      }
    }
  },
  "$defs": {
    "AssetGroup": {
      "type": "object",
      "required": [
        "slug",
        "name",
        "assets"
      ],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "$ref": "#/$defs/Category/properties/slug"
        },
        "name": {
          "$ref": "#/$defs/Category/properties/name"
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GroupAsset"
          }
        }
      }
    },
    "GroupAsset": {
      "type": "object",
      "required": [
        "path",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/Asset/properties/path"
        },
        "type": {
          "$ref": "#/$defs/Asset/properties/type"
        }
      }
    },
    "Category": {
      "type": "object",
      "required": [
        "name",
        "assets"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
          "description": "Kebab-case identifier for the category (e.g. 'sales-marketing')."
        },
        "description": {
          "type": "string",
          "maxLength": 256,
          "description": "One-sentence description of what this category covers, shown in the UI."
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Asset"
          }
        }
      }
    },
    "Asset": {
      "type": "object",
      "required": [
        "path",
        "type",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 3,
          "maxLength": 192,
          "pattern": "^(skills|plugins|mcps|agents)/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*[a-z0-9]$",
          "description": "Relative path in the format '{type_dir}/{category}/{kebab-case-name}'."
        },
        "type": {
          "type": "string",
          "enum": [
            "skill",
            "plugin",
            "mcp",
            "agent"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "Stable asset ID: a lowercase hyphenated UUIDv4 (8-4-4-4-12), the same as the id in the asset's manifest. Assigned once by scripts/asset_ids.py and never changed."
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 digest of the skill's published files, generated by scripts/skills_checksum.py. Required for skill assets."
        },
        "publisher_type": {
          "type": "string",
          "enum": [
            "AMAZON",
            "THIRD_PARTY"
          ],
          "description": "Publisher classification. Defaults to a first-party (Amazon) skill when omitted; THIRD_PARTY marks a partner-contributed skill."
        },
        "company": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Display name of the publishing company. Required when publisher_type is THIRD_PARTY."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Plugin assets only. Overrides the plugin.json displayName."
        },
        "icon": {
          "type": "string",
          "pattern": "^assets/[a-z0-9][a-z0-9._-]*\\.svg$",
          "description": "Plugin assets only. Overrides the plugin.json icon."
        },
        "kind": {
          "type": "string",
          "enum": [
            "solution",
            "package",
            "partner"
          ],
          "description": "Plugin assets only. Overrides the plugin.json kind."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "skill"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "checksum"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "publisher_type": {
                "const": "THIRD_PARTY"
              }
            },
            "required": [
              "publisher_type"
            ]
          },
          "then": {
            "required": [
              "company"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "not": {
                  "const": "plugin"
                }
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "displayName"
                  ]
                },
                {
                  "required": [
                    "icon"
                  ]
                },
                {
                  "required": [
                    "kind"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
