{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AWS Quick Official Catalog",
  "description": "Schema for the AWS Quick Official Catalog used to list skills and assets.",
  "type": "object",
  "required": [
    "categories",
    "roles",
    "industries"
  ],
  "additionalProperties": false,
  "properties": {
    "categories": {
      "type": "array",
      "minItems": 1,
      "description": "The category filter that current AWS Quick versions show. Every released skill and plugin has an entry here. Keep it until every AWS Quick version reads roles and industries.",
      "items": {
        "$ref": "#/$defs/Category"
      }
    },
    "roles": {
      "type": "array",
      "description": "Role filter values for AWS Quick versions that read roles and industries. Each lists, by path, assets that categories already lists. Every catalog asset is in exactly one role or one industry, never both; scripts/catalog_check.py enforces this. Only the approved roles in RoleValue are allowed.",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/AssetGroup"
          },
          {
            "$ref": "#/$defs/RoleValue"
          }
        ]
      }
    },
    "industries": {
      "type": "array",
      "description": "Industry filter values for AWS Quick versions that read roles and industries. Each lists, by path, assets that categories already lists. Every catalog asset is in exactly one role or one industry, never both; scripts/catalog_check.py enforces this. Only the approved industries in IndustryValue are allowed, so the catalog never shows an industry that isn't in the product's industries list.",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/AssetGroup"
          },
          {
            "$ref": "#/$defs/IndustryValue"
          }
        ]
      }
    }
  },
  "$defs": {
    "RoleValue": {
      "description": "The approved roles, each a fixed slug and name pair. Adding or removing a role needs product approval first.",
      "oneOf": [
        {
          "properties": {
            "slug": {
              "const": "general"
            },
            "name": {
              "const": "General"
            }
          }
        },
        {
          "properties": {
            "slug": {
              "const": "customer-success"
            },
            "name": {
              "const": "Customer Success"
            }
          }
        },
        {
          "properties": {
            "slug": {
              "const": "data-analytics"
            },
            "name": {
              "const": "Data Analysis"
            }
          }
        },
        {
          "properties": {
            "slug": {
              "const": "design"
            },
            "name": {
              "const": "Design"
            }
          }
        },
        {
          "properties": {
            "slug": {
              "const": "finance"
            },
            "name": {
              "const": "Finance"
            }
          }
        },
        {
          "properties": {
            "slug": {
              "const": "hr"
            },
            "name": {
              "const": "HR"
            }
          }
        },
        {
          "properties": {
            "slug": {
              "const": "leadership"
            },
            "name": {
              "const": "Leadership"
            }
          }
        },
        {
          "properties": {
            "slug": {
              "const": "marketing"
            },
            "name": {
              "const": "Marketing"
            }
          }
        },
        {
          "properties": {
            "slug": {
              "const": "project-management"
            },
            "name": {
              "const": "Project Management"
            }
          }
        },
        {
          "properties": {
            "slug": {
              "const": "sales"
            },
            "name": {
              "const": "Sales"
            }
          }
        },
        {
          "properties": {
            "slug": {
              "const": "security-compliance"
            },
            "name": {
              "const": "Security & Compliance"
            }
          }
        },
        {
          "properties": {
            "slug": {
              "const": "software-engineering"
            },
            "name": {
              "const": "Software Engineering"
            }
          }
        }
      ]
    },
    "IndustryValue": {
      "description": "The approved industries, each a fixed slug and name pair. Adding or removing an industry needs product approval first, and the industries list in AWS Quick must change with it.",
      "oneOf": [
        {
          "properties": {
            "slug": {
              "const": "power-utilities"
            },
            "name": {
              "const": "Power & Utilities"
            }
          }
        },
        {
          "properties": {
            "slug": {
              "const": "oil-gas"
            },
            "name": {
              "const": "Oil & Gas"
            }
          }
        },
        {
          "properties": {
            "slug": {
              "const": "financial-services"
            },
            "name": {
              "const": "Financial Services"
            }
          }
        },
        {
          "properties": {
            "slug": {
              "const": "healthcare"
            },
            "name": {
              "const": "Healthcare"
            }
          }
        },
        {
          "properties": {
            "slug": {
              "const": "life-sciences"
            },
            "name": {
              "const": "Life Sciences"
            }
          }
        },
        {
          "properties": {
            "slug": {
              "const": "hospitality"
            },
            "name": {
              "const": "Retail & Hospitality"
            }
          }
        },
        {
          "properties": {
            "slug": {
              "const": "legal"
            },
            "name": {
              "const": "Legal"
            }
          }
        },
        {
          "properties": {
            "slug": {
              "const": "supply-chain"
            },
            "name": {
              "const": "Manufacturing & Supply Chain"
            }
          }
        }
      ]
    },
    "AssetGroup": {
      "type": "object",
      "required": [
        "slug",
        "name",
        "description",
        "assets"
      ],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "$ref": "#/$defs/Category/properties/slug"
        },
        "name": {
          "$ref": "#/$defs/Category/properties/name"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "One plain-language sentence on who the role or industry is for and what its skills help with, shown in the UI."
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GroupAsset"
          }
        }
      }
    },
    "GroupAsset": {
      "type": "object",
      "required": [
        "path",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/Asset/properties/path"
        },
        "type": {
          "$ref": "#/$defs/Asset/properties/type"
        }
      }
    },
    "Category": {
      "type": "object",
      "required": [
        "name",
        "assets"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
          "description": "Kebab-case identifier for the category (e.g. 'sales-marketing')."
        },
        "description": {
          "type": "string",
          "maxLength": 256,
          "description": "One-sentence description of what this category covers, shown in the UI."
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Asset"
          }
        }
      }
    },
    "Asset": {
      "type": "object",
      "required": [
        "path",
        "type",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 3,
          "maxLength": 192,
          "pattern": "^(skills|plugins|mcps|agents)/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*[a-z0-9]$",
          "description": "Relative path in the format '{type_dir}/{category}/{kebab-case-name}'."
        },
        "type": {
          "type": "string",
          "enum": [
            "skill",
            "plugin",
            "mcp",
            "agent"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "Stable asset ID: a lowercase hyphenated UUIDv4 (8-4-4-4-12), the same as the id in the asset's manifest. Assigned once by scripts/asset_ids.py and never changed."
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 digest of the asset's published files, generated by scripts/asset_checksums.py. A skill's digest covers its folder; a plugin's covers its own folder, not the skills it installs. Required for skill and plugin assets."
        },
        "publisher_type": {
          "type": "string",
          "enum": [
            "AMAZON",
            "THIRD_PARTY"
          ],
          "description": "Publisher classification. Defaults to a first-party (Amazon) skill when omitted; THIRD_PARTY marks a partner-contributed skill."
        },
        "company": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Display name of the publishing company. Required when publisher_type is THIRD_PARTY."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Plugin assets only. Overrides the plugin.json displayName."
        },
        "icon": {
          "type": "string",
          "pattern": "^assets/[a-z0-9][a-z0-9._-]*\\.svg$",
          "description": "Plugin assets only. Overrides the plugin.json icon."
        },
        "kind": {
          "type": "string",
          "enum": [
            "solution",
            "package",
            "partner"
          ],
          "description": "Plugin assets only. The plugin's kind: solution, package, or partner."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "skill",
                  "plugin"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "checksum"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "publisher_type": {
                "const": "THIRD_PARTY"
              }
            },
            "required": [
              "publisher_type"
            ]
          },
          "then": {
            "required": [
              "company"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "not": {
                  "const": "plugin"
                }
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "displayName"
                  ]
                },
                {
                  "required": [
                    "icon"
                  ]
                },
                {
                  "required": [
                    "kind"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
