{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Amazon Quick Official Catalog",
  "description": "Schema for the Amazon Quick Official Catalog used to list skills and assets.",
  "type": "object",
  "required": [
    "skillsChecksum",
    "categories"
  ],
  "additionalProperties": false,
  "properties": {
    "skillsChecksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Roll-up SHA-256 over the per-skill checksums of the published set (sorted 'path\\tchecksum' lines), generated by scripts/skills_checksum.py."
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Category"
      }
    },
    "roles": {
      "type": "array",
      "description": "Role filter values. Each lists the assets tagged with it; an asset may appear under several values or none.",
      "items": {
        "$ref": "#/$defs/TagValue"
      }
    },
    "industries": {
      "type": "array",
      "description": "Industry filter values. Each lists the assets tagged with it; an asset may appear under several values or none.",
      "items": {
        "$ref": "#/$defs/TagValue"
      }
    }
  },
  "$defs": {
    "TagValue": {
      "type": "object",
      "required": [
        "slug",
        "name",
        "assets"
      ],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
          "description": "Kebab-case match key for the value (e.g. 'oil-gas')."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Display name shown in the filter."
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssetRef"
          }
        }
      }
    },
    "AssetRef": {
      "type": "object",
      "required": [
        "path",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Path of an asset listed in categories."
        },
        "type": {
          "type": "string",
          "enum": [
            "skill",
            "plugin",
            "mcp",
            "agent",
            "acp"
          ]
        }
      }
    },
    "Category": {
      "type": "object",
      "required": [
        "name",
        "assets"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
          "description": "Kebab-case identifier for the category (e.g. 'sales-marketing')."
        },
        "description": {
          "type": "string",
          "maxLength": 256,
          "description": "One-sentence description of what this category covers, shown in the UI."
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Asset"
          }
        }
      }
    },
    "Asset": {
      "type": "object",
      "required": [
        "path",
        "type",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]{3}-[0-9a-f]{12}4[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "description": "Stable asset ID: the asset type's 3-letter code, a hyphen, and a UUIDv4 as 32 lowercase hex. Assigned once and never changed."
        },
        "path": {
          "type": "string",
          "minLength": 3,
          "maxLength": 192,
          "pattern": "^(skills|plugins|mcps|agents|acps)/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*[a-z0-9]$",
          "description": "Relative path in the format '{type_dir}/{category}/{kebab-case-name}'."
        },
        "type": {
          "type": "string",
          "enum": [
            "skill",
            "plugin",
            "mcp",
            "agent",
            "acp"
          ]
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 digest of the skill's published files, generated by scripts/skills_checksum.py. Required for skill assets."
        },
        "publisher_type": {
          "type": "string",
          "enum": [
            "AMAZON",
            "THIRD_PARTY"
          ],
          "description": "Publisher classification. Defaults to a first-party (Amazon) skill when omitted; THIRD_PARTY marks a partner-contributed skill."
        },
        "company": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Display name of the publishing company. Required when publisher_type is THIRD_PARTY."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "skill"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "checksum"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "publisher_type": {
                "const": "THIRD_PARTY"
              }
            },
            "required": [
              "publisher_type"
            ]
          },
          "then": {
            "required": [
              "company"
            ]
          }
        }
      ]
    }
  }
}
